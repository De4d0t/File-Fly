{
  "name": "filefly",
  "version": "1.0.0",
  "description": "Fast local network file transfer app for Windows, Android, iPhone & Mac",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:vite": "vite",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:vite\"",
    "build": "vite build",
    "build:exe": "vite build && electron-builder --win",
    "electron:dev": "concurrently -k \"npm run dev:server\" \"vite\" \"wait-on tcp:5173 && electron .\"",
    "start": "node server/index.js",
    "version:set": "node scripts/sync-version.js",
    "version:sync": "node scripts/sync-version.js",
    "version": "node scripts/sync-version.js && git add website/package.json"
  },
  "build": {
    "appId": "com.filefly.app",
    "productName": "FileFly",
    "directories": {
      "output": "dist-app"
    },
    "win": {
      "target": "portable"
    }
  },
  "keywords": [
    "file-transfer",
    "local-network",
    "airdrop",
    "wifi-transfer",
    "cross-platform"
  ],
  "author": "FileFly Team",
  "license": "MIT",
  "dependencies": {
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "form-data": "^4.0.2",
    "lucide-react": "^0.475.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
